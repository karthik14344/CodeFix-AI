.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
.codefix-junit.xml

# Secrets - at any level, deliberately unanchored
.env

# Local run state. Anchored to the repo root with a leading slash: gitignore patterns without
# one match at EVERY level, and a bare `runs.db*` / `traces/` silently ignored
# benchmarks/seed/runs.db and benchmarks/seed/traces/ - the 187-run study the deployed
# dashboard and the report are built from - so it was never committed.
/.codefix/
/runs.db*
/checkpoints.db*
/traces/

# Office lock files
~$*

# local tooling and logs - never part of the project
.claude/
*.log
*.err
